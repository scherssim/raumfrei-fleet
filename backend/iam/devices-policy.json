{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NurDieseEineTabelle",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{TABLE_NAME}}"
    },
    {
      "Sid": "EigeneLogGruppe",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/aws/lambda/RaumFreiDeviceHandler:*"
    }
  ]
}
