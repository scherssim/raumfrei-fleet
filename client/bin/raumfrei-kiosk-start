#!/usr/bin/env bash
# raumfrei-kiosk-start - startet die Anzeige auf seat0.
#
# Wird von raumfrei-kiosk.service aufgerufen, die die Werte aus
# /etc/raumfrei/kiosk.env mitbringt (von der Ansible-Rolle kiosk gerendert):
#
#   KIOSK_URL      http://127.0.0.1:8080/display.html?room=201
#   KIOSK_BROWSER  Wunschbrowser aus dem Soll-Zustand (luakit|cog|chromium|firefox)
#
# Zwei Dinge macht dieses Skript, die eine ExecStart-Zeile nicht koennte:
#
#   1. Es wartet, bis raumfrei-display.service tatsaechlich antwortet. Ein
#      minimaler Viewer laedt eine Seite genau einmal; startet er eine
#      Sekunde zu
#      frueh, steht bis zum naechsten Neustart eine Fehlerseite auf dem
#      Tuerschild. systemd-Abhaengigkeiten helfen hier nicht, weil der
#      Python-Server nach dem fork sofort als "gestartet" gilt.
#
#   2. Es faellt auf einen vorhandenen Browser zurueck. Der Wunsch aus dem
#      Backend gewinnt, wenn er installiert ist - sonst die naechste Wahl.
#      Ein Tuerschild ohne Browser ist schlechter als eines mit dem zweiten.
#
# Die Reihenfolge (luakit vor cog vor chromium vor firefox) folgt dem Grundsatz
# fuer Wayland-Kiosks: ein reiner WebKit-Viewer ohne Bedienelemente, rund
# 40 MB RSS statt ~250 MB bei chromium.
#
# luakit steht seit dem 31.08.2026 vor cog, weil cog in Ubuntu 24.04 gar
# nicht paketiert ist; cog bleibt in der Liste, weil es unter Debian die
# bessere Wahl waere. surf taucht bewusst NICHT auf: es ist zwar ein echtes
# .deb, aber X11-only und stirbt unter cage an BadWindow. Siehe
# group_vars/all.yml.

set -uo pipefail

log() { echo "raumfrei-kiosk: $*"; }

KIOSK_URL="${KIOSK_URL:-http://127.0.0.1:8080/display.html}"
KIOSK_BROWSER="${KIOSK_BROWSER:-luakit}"

# --- 1 Auf den lokalen Auslieferer warten -----------------------------------
for attempt in $(seq 1 30); do
    if curl -fsS --max-time 2 -o /dev/null "$KIOSK_URL"; then
        log "Anzeigeseite antwortet nach ${attempt} Versuch(en)."
        break
    fi
    if [ "$attempt" -eq 30 ]; then
        # Trotzdem starten: besser eine Fehlerseite als ein schwarzer Schirm,
        # und Restart=always versucht es in drei Sekunden erneut.
        log "WARNUNG: ${KIOSK_URL} antwortet nach 30 Versuchen nicht."
    fi
    sleep 1
done

# --- 2 Browser waehlen -------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

BROWSER=""
for candidate in "$KIOSK_BROWSER" luakit cog chromium chromium-browser firefox; do
    [ -n "$candidate" ] || continue
    if have "$candidate"; then BROWSER="$candidate"; break; fi
done

if [ -z "$BROWSER" ]; then
    log "ABBRUCH: kein Browser gefunden (gewuenscht: ${KIOSK_BROWSER})."
    exit 1
fi
if [ "$BROWSER" != "$KIOSK_BROWSER" ]; then
    log "Wunschbrowser '${KIOSK_BROWSER}' fehlt, verwende '${BROWSER}'."
fi
log "Browser ${BROWSER} auf ${KIOSK_URL}"

case "$BROWSER" in
    chromium|chromium-browser)
        # --incognito verhindert, dass sich ein abgestuerzter Lauf beim
        # naechsten Start mit "Wiederherstellen?" ueber die Anzeige legt.
        set -- "$BROWSER" \
            --kiosk \
            --incognito \
            --noerrdialogs \
            --disable-infobars \
            --disable-session-crashed-bubble \
            --disable-features=TranslateUI \
            --check-for-update-interval=31536000 \
            --ozone-platform=wayland \
            "$KIOSK_URL"
        ;;
    firefox)
        set -- firefox --kiosk "$KIOSK_URL"
        ;;
    *)
        # cog, luakit und jeder andere minimale Viewer nehmen die URL als
        # einziges Argument; cage macht den Client ohnehin
        # bildschirmfuellend, einen Vollbildschalter braucht keiner davon.
        #
        # Dieser Zweig ist zugleich der Rueckfall fuer einen unbekannten
        # Wunschbrowser. Vorher gab es ihn nicht: "$@" blieb leer und cage
        # startete ohne Client, also mit schwarzem Schirm und ohne Fehler.
        set -- "$BROWSER" "$KIOSK_URL"
        ;;
esac

# cage haelt genau einen Client im Vollbild auf seat0 - kein Desktop, kein
# Login-Manager, keine Tastenkombination, die aus dem Kiosk herausfuehrt.
exec cage -s -- "$@"
